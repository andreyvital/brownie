# letzplay.me login (profile name or e-mail)
LETZPLAY_EMAIL=you@example.com
LETZPLAY_PASSWORD=

# Club slug from https://letzplay.me/<club>/club (default: clavatenis)
LETZPLAY_CLUB=clavatenis

# EZVIZ app login with access to the camera, for the /live page; leave empty to disable it
EZVIZ_EMAIL=
EZVIZ_PASSWORD=

# Serial of the camera shown on /live (default: BG5113153, "Quadra externa 2")
EZVIZ_CAMERA=BG5113153

# Set to false to watch the browser (default: true)
HEADLESS=true

# WhatsApp: the bot account linked by `bun run whatsapp` (only needed for the first link)
# and who it sends to, both with country code
WHATSAPP_PHONE=
WHATSAPP_TO=

# Password for /send (HTTP basic auth, any user name); leave empty to disable the page
SEND_PASSWORD=

# Who /send can message, as Name=number pairs
WHATSAPP_CONTACTS=Andrey=5511999999999,Someone=5511888888888
