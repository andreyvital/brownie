# letzplay.me login (profile name or e-mail)
LETZPLAY_EMAIL=you@example.com
LETZPLAY_PASSWORD=

# Club slug from https://letzplay.me/<club>/club (default: clavatenis)
LETZPLAY_CLUB=clavatenis

# EZVIZ Open Platform app (https://isaopen.ezviz.com/console/home.html) for the /live page; leave empty to disable it
EZVIZ_APP_KEY=
EZVIZ_APP_SECRET=

# Serial of the camera shown on /live (default: BG5113153, "Quadra externa 2")
EZVIZ_CAMERA=BG5113153

# Set to false to watch the browser (default: true)
HEADLESS=true
